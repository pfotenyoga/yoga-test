{
  "name": "yoga-mit-pfoten-node",
  "version": "1.0.0",
  "private": true,
  "description": "Kursbuchung für Yoga mit und ohne Hund, mit Konten für Kunden, Trainer und Admin",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
